# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Віртуальне середовище
.venv/
venv/

# Django
db.sqlite3
db.sqlite3-journal
# Саме /media/* , а не /media/ : виключений каталог git не переглядає
# взагалі, і виняток для .gitkeep нижче не спрацював би.
/media/*
!/media/.gitkeep
/staticfiles/
/logs/
*.log

# Секрети
.env
.env.local

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db
desktop.ini
.DS_Store


# Бекапи бази
*.bak
db-backup-*.json

# Фотоконвеєр: оригінали й вхідні файли в git не потрапляють.
/media/_originals/
/photos_in/



# Coverage: сирі дані й HTML-звіт (текстовий звіт лежить у docs/)
.coverage
.coverage.*
htmlcov/
