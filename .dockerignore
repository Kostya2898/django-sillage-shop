# Контекст збірки. Усе, чого тут немає, копіюється в образ через `COPY . .`

# Секрети й локальні дані — ніколи в образ.
.env
.env.*
!.env.example
db.sqlite3
db.sqlite3-journal
*.bak

# Завантажені фото й результати грейду. У git їх теж немає; у контейнері
# медіа живуть у томі, а не в шарі образу.
media/

# Згенероване: образ збирає статику сам.
staticfiles/
logs/
htmlcov/
.coverage
.coverage.*

# Середовища й кеші.
.venv/
venv/
__pycache__/
*.py[cod]
.ruff_cache/
.pytest_cache/

# Інструменти й службове, що в роботі сайту не бере участі.
.git/
.github/
.idea/
.vscode/
node_modules/
