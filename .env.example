# ---------------------------------------------------------------------------
# SILLAGE — приклад файлу оточення
#
# Скопіюй у .env і заповни. Сам .env у git НЕ потрапляє.
#     Windows PowerShell:  Copy-Item .env.example .env
#     bash:                cp .env.example .env
#
# Для розробки .env взагалі не обовʼязковий — shop_project/settings/dev.py
# має безпечні дефолти на кожну змінну. Для prod обовʼязкові SECRET_KEY
# і ALLOWED_HOSTS: без них запуск падає навмисно.
# ---------------------------------------------------------------------------

# --- Основне --------------------------------------------------------------

# У prod — щонайменше 50 випадкових символів; порожній, короткий або ключ
# розробки валить старт з ImproperlyConfigured. Згенерувати новий:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-50-random-characters

DEBUG=True

# Через кому, без пробілів.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Тільки prod, за HTTPS-проксі. Через кому, зі схемою.
# CSRF_TRUSTED_ORIGINS=https://sillage.example.com


# --- База даних -----------------------------------------------------------

# sqlite:///абсолютний/шлях/db.sqlite3
# postgres://user:password@localhost:5432/sillage
DATABASE_URL=sqlite:///db.sqlite3


# --- Кеш ------------------------------------------------------------------

# Порожньо або немає       — LocMemCache: проєкт піднімається без Redis
# redis://127.0.0.1:6379/1 — django-redis; У PROD ОБОВʼЯЗКОВО: ліміти входу
#                            рахуються в кеші, а LocMemCache в кожного воркера
#                            gunicorn свій (check --deploy дає E003)
# dummycache://            — кеш вимкнено
CACHE_URL=


# --- Пошта ----------------------------------------------------------------

# consolemail://                              — друк у консоль (розробка)
# smtp://user:password@smtp.example.com:587/?tls=True
EMAIL_URL=consolemail://

DEFAULT_FROM_EMAIL=shop@example.com
SERVER_EMAIL=shop@example.com

# Формат: "Імʼя:пошта", кілька — через кому.
ADMINS=Адміністратор магазину:admin@example.com


# --- Платежі (мок платіжного шлюзу) ---------------------------------------

PAYMENT_CURRENCY=UAH
# Частка від суми замовлення: 0.20 = 20%.
PAYMENT_TAX_RATE=0.00
PAYMENT_SECRET_KEY=replace-me-payment-secret
PAYMENT_API_URL=https://api.example-gateway.com/v3/payments


# --- Кошик ----------------------------------------------------------------

# Максимальна кількість одного товару в кошику.
CART_MAX_QUANTITY_PER_PRODUCT=99


# --- Логування ------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# --- Безпека (тільки prod; дефолти вже ввімкнені) -------------------------

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# Увімкнено за замовчуванням: TLS термінує проксі (Railway, Render, nginx).
# Вимикати лише якщо gunicorn відкритий в інтернет напряму — інакше
# SECURE_SSL_REDIRECT зациклиться. Для docker compose на http://localhost
# SECURE_SSL_REDIRECT і *_COOKIE_SECURE ставляться в False у compose-файлі.
# USE_X_FORWARDED_PROTO=True

# --- Реквізити продавця для PDF-рахунку ---
INVOICE_SELLER_NAME=ТОВ «Сіяж»
INVOICE_SELLER_LEGAL=ЄДРПОУ 00000000
INVOICE_SELLER_ADDRESS=вул. Ярославів Вал, 15, Київ, 01034
INVOICE_SELLER_BANK=IBAN UA00 0000 0000 0000 0000 0000 000
INVOICE_SELLER_PHONE=+380 44 000 00 00
INVOICE_SELLER_EMAIL=hello@sillage.ua
INVOICE_SELLER_SIGNATORY=Директор — К. Гринюк

# --- Посилання в листах ---
SITE_URL=http://127.0.0.1:8000
GUEST_ORDER_LINK_DAYS=60

# --- Docker і хостинг -------------------------------------------------------

# Віддавати /media/ самим Django при DEBUG=False. Лише без nginx/S3 перед
# застосунком (docker-compose.yml вмикає). Див. shop_project/urls.py.
# SERVE_MEDIA=False

# Тримати з'єднання з Postgres між запитами, секунд.
# CONN_MAX_AGE=60

# docker/entrypoint.sh: заповнити порожній каталог демо-даними на старті.
# SEED_DEMO_DATA=1
# GUNICORN_WORKERS=3
