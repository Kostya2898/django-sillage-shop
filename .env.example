# ---------------------------------------------------------------------------
# SILLAGE — приклад файлу оточення
#
# Скопіюй у .env і заповни. Сам .env у git НЕ потрапляє.
#     Windows PowerShell:  Copy-Item .env.example .env
#     bash:                cp .env.example .env
#
# Для розробки .env взагалі не обовʼязковий — shop_project/settings/dev.py
# має безпечні дефолти на кожну змінну. Для prod обовʼязкові SECRET_KEY
# і ALLOWED_HOSTS: без них запуск падає навмисно.
# ---------------------------------------------------------------------------

# --- Основне --------------------------------------------------------------

# Згенерувати новий:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me-with-50-random-characters

DEBUG=True

# Через кому, без пробілів.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Тільки prod, за HTTPS-проксі. Через кому, зі схемою.
# CSRF_TRUSTED_ORIGINS=https://sillage.example.com


# --- База даних -----------------------------------------------------------

# sqlite:///абсолютний/шлях/db.sqlite3
# postgres://user:password@localhost:5432/sillage
DATABASE_URL=sqlite:///db.sqlite3


# --- Кеш ------------------------------------------------------------------

# locmemcache://           — у памʼяті процесу (розробка)
# dummycache://            — кеш вимкнено
# rediscache://127.0.0.1:6379/1
CACHE_URL=locmemcache://


# --- Пошта ----------------------------------------------------------------

# consolemail://                              — друк у консоль (розробка)
# smtp://user:password@smtp.example.com:587/?tls=True
EMAIL_URL=consolemail://

DEFAULT_FROM_EMAIL=shop@example.com
SERVER_EMAIL=shop@example.com

# Формат: "Імʼя:пошта", кілька — через кому.
ADMINS=Адміністратор магазину:admin@example.com


# --- Платежі (мок платіжного шлюзу) ---------------------------------------

PAYMENT_CURRENCY=UAH
# Частка від суми замовлення: 0.20 = 20%.
PAYMENT_TAX_RATE=0.00
PAYMENT_SECRET_KEY=replace-me-payment-secret
PAYMENT_API_URL=https://api.example-gateway.com/v3/payments


# --- Кошик ----------------------------------------------------------------

# Максимальна кількість одного товару в кошику.
CART_MAX_QUANTITY_PER_PRODUCT=99


# --- Логування ------------------------------------------------------------

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO


# --- Безпека (тільки prod; дефолти вже ввімкнені) -------------------------

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# Увімкнути, якщо TLS термінує nginx/Traefik перед Django.
# USE_X_FORWARDED_PROTO=True
